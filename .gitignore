# ── Data (public datasets - download them, don't commit them) ────────────────
/Dataset
/Dataset_*/
/preprocessed/
*.zip

# ── Preprocessing: only the script is tracked, not its outputs ──────────────
/pre-processing/*
!/pre-processing/preprocess.py

# ── Model training leftovers (the LoRA adapter itself IS tracked) ─────────────
/qwen3-hdfs-ckpt/qwen3-hdfs-ckpt/

# ── Agent runtime output (medallion layers, run memory, reports) ──────────────
/data/

# ── Coursework documents, captures and stray files ────────────────────────────
*.docx
~$*
*.pcap
/image*.png

# ── Python / Jupyter / tooling ───────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.env

# ── Baselines ────────────────────────────────────────────────────────────────
/Baselines/TCN/__pycache__
/Baselines/TCN/artifacts
/Baselines/TCN/run_hdfs_v1_20260315_193137.summary.json
/Baselines/TCN/run_hdfs_v1_20260315_193811.summary.json
/Baselines/TCN/train_hdfs_v1_20260315_193811.log

# ── Local tooling, editors and OS files ──────────────────────────────────────
.claude/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets (never commit keys) ──────────────────────────────────────────────
.streamlit/secrets.toml
.env.*
*.key
*.pem

# ── Caches, coverage and build output ────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
*.tmp
*.bak
nohup.out
*.log.*

# ── Scratch: slide-deck working folders and new decks (the existing deck stays tracked) ──
/.tmp_ppt/
*.pptx
*.potx

# ── Large files regenerated by the scripts ───────────────────────────────────
# (the trained models in artifacts/ and the repo root ARE tracked: the app needs them)
/artifacts/*/*.tmp
/artifacts/_cv_tmp/

